<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "BtrBlocks - Better building blocks for the cloud" }}</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
    {# favicon plugin segfaults  #}
    {# favicon './content/btrblocks.svg' #}
    {#- Add an arbitrary string to the bundle #}
    {%- css %}{% include "public/css/base.css" %}{% endcss %}
    {%- css %}{% include "public/css/home.css" %}{% endcss %}
    <style>{% getBundle "css" %}</style>
</head>
<body>
    {# The layout includes the header and the footer. Content itself is provided by whatever page uses this layout #}

    <header>
        <div class="logo logo-svg">
            {%- from 'img/logo.svg' import logo %}
            {{ logo({ class: 'logo-img' }) }}
        </div>
        <span class="logo logo-text">BtrBlocks</span>
    </header>

    {{ content | safe }}

    <footer>
        <div class="container">
            <p>&copy; {% currentYear %} BtrBlocks GmbH</p>
            <p class="footer-links">
                <a href="/blog/">Blog</a> &middot;
                <a href="/feed/feed.xml">RSS</a> &middot;
                <a href="/imprint/">Imprint</a> &middot;
                <a href="/privacy/">Privacy</a>
            </p>
        </div>
    </footer>
</body>
</html>
